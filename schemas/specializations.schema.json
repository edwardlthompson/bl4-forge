{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edwardlthompson.github.io/bl4-forge/schemas/specializations.schema.json",
  "title": "BL4 Forge Specializations",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "nodes", "socket_thresholds", "max_equipped"],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "note": { "type": "string" },
    "evidence": { "type": "array", "items": { "type": "string" } },
    "socket_thresholds": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "integer", "minimum": 0 }
    },
    "max_equipped": { "type": "integer", "minimum": 1, "maximum": 4 },
    "trees": { "type": "array" },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "skills"],
        "properties": {
          "id": { "type": "string" },
          "display_name": { "type": "string" },
          "kind": { "enum": ["base", "prestige"] },
          "requires_nodes": { "type": "array", "items": { "type": "string" } },
          "require_points_each": { "type": "integer", "minimum": 0 },
          "node_bonus": { "type": "object", "additionalProperties": { "type": "number" } },
          "skills": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "unlock_points"],
              "properties": {
                "id": { "type": "string" },
                "unlock_points": { "type": "integer", "minimum": 1 },
                "synergy": { "type": "array", "items": { "type": "string" } },
                "proc": { "type": "string" },
                "effect_text": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
