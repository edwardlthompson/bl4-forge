{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edwardlthompson.github.io/bl4-forge/schemas/effect.schema.json",
  "title": "BL4 Forge Effect",
  "type": "object",
  "additionalProperties": false,
  "required": ["op", "target", "value", "oracle"],
  "properties": {
    "op": {
      "type": "string",
      "enum": ["add", "mul", "set", "flag"]
    },
    "target": { "type": "string", "minLength": 1 },
    "value": { "type": ["number", "boolean", "string"] },
    "values_by_rank": {
      "type": "array",
      "items": { "type": "number" },
      "minItems": 1,
      "description": "Cumulative magnitude at each rank (index = rank-1). Overrides value when resolving at rank."
    },
    "cond": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "always",
            "on_kill",
            "on_crit",
            "on_reload",
            "while_shield_down",
            "while_moving",
            "while_airborne",
            "ads",
            "on_ordnance_hit",
            "on_melee",
            "while_overdrive"
          ]
        },
        "window_s": { "type": "number", "minimum": 0 }
      }
    },
    "stack_max": { "type": "integer", "minimum": 1 },
    "tags": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "behavior_tags": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "description": "Synergy ontology tags (spawn_grenade, splash, chain_explode, …)"
    },
    "stage": {
      "type": "string",
      "enum": ["on_shot", "on_hit", "rate", "flag"],
      "description": "On Shot × On Hit damage pipeline bucket"
    },
    "source_part": { "type": "string" },
    "oracle": {
      "type": "string",
      "enum": ["card_match", "name_inferred", "manual"]
    },
    "unparsed": { "type": "boolean" },
    "tag_only": { "type": "boolean" },
    "label": { "type": "string", "description": "Human label for guide/stats display" }
  }
}
