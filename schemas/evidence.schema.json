{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edwardlthompson.github.io/bl4-forge/schemas/evidence.schema.json",
  "title": "BL4 Forge Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "retrieved_at"],
  "properties": {
    "kind": {
      "type": "string",
      "enum": ["datamine_drop", "card_oracle", "ingame_verified"]
    },
    "ref": { "type": "string" },
    "result": {
      "type": "string",
      "enum": ["pass", "fail"]
    },
    "game_build": { "type": "string" },
    "by": { "type": "string" },
    "batch": { "type": "string" },
    "retrieved_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    }
  },
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "card_oracle" } } },
      "then": { "required": ["ref", "result"] }
    },
    {
      "if": { "properties": { "kind": { "const": "datamine_drop" } } },
      "then": { "required": ["ref"] }
    },
    {
      "if": { "properties": { "kind": { "const": "ingame_verified" } } },
      "then": { "required": ["by", "batch"] }
    }
  ]
}
